# Webcam streamer for the PAX app. Installed by install-camera.sh, which fills
# in the __PLACEHOLDERS__. Logs: journalctl -u pax-camera -f

[Unit]
Description=PAX webcam MJPEG streamer
After=network.target

[Service]
Type=simple
User=__USER__
SupplementaryGroups=video
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 __DIR__/pax_camera.py --device __DEVICE__ --port __PORT__ --size __SIZE__ --fps __FPS__
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
