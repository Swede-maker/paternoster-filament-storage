# systemd unit so the agent starts on boot and restarts on crash.
#
# Install:
#   sudo cp paternoster-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now paternoster-agent
#
# Check status / logs:
#   systemctl status paternoster-agent
#   journalctl -u paternoster-agent -f
#
# Edit --name / --shelves / --port below to match this unit.

[Unit]
Description=PAX paternoster GPIO agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi-agent
ExecStart=/usr/bin/python3 /home/pi/pi-agent/paternoster_agent.py --name "Paternoster 1" --shelves 9 --port 8765
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
